# Database Configuration
# Local Development
DB_HOST=localhost
DB_NAME=sdev_app
DB_USER=root
DB_PASSWORD=

# Third-party Server (InfinityFree or Similar)
DB_HOST_THIRD=sql113.infinityfree.com
DB_NAME_THIRD=sdev_app
DB_USER_THIRD=your_username
DB_PASSWORD_THIRD=your_password

# Docker Environment
DB_HOST_DOCKER=mariadb
DB_NAME_DOCKER=response_builder
DB_USER_DOCKER=root
DB_PASSWORD_DOCKER=your_secure_password

# Application Users (Docker MariaDB)
DB_APP_USER=app_user
DB_APP_PASSWORD=app_user_password

# Email Configuration
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASSWORD=your_app_password

# Encryption Keys
# IMPORTANT: Change this to a secure random string in production
ENCRYPTION_SECRET=your_secure_encryption_key_here

# Optional: Set environment based on deployment
# APP_ENV=development
# APP_ENV=production
